{
  "name": "@launchpad/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:migrate": "tsx src/migrate.ts",
    "db:seed:demo": "tsx src/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@launchpad/contracts": "0.1.0",
    "@launchpad/shared": "0.1.0",
    "ethers": "^6.15.0",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "siwe": "^2.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
