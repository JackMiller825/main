# Copy to .env for local API/worker processes. Do not put secrets in frontend variables.
# Demo startup does not need these values.

APP_MODE=demo
CHAIN_ID=11155111
DATABASE_URL=postgres://launchpad:launchpad@localhost:5432/launchpad
REDIS_URL=redis://localhost:6379
RPC_HTTP_URL=https://your-ethereum-http-endpoint.example
RPC_WS_URL=wss://your-ethereum-websocket-endpoint.example
EXPLORER_API_KEY=your-explorer-api-key
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:5173
AUTH_DOMAIN=localhost:5173
AUTH_URI=http://localhost:5173
OWNER_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
ALLOWED_WALLET_ADDRESSES=0x0000000000000000000000000000000000000000
SIGNER_MODE=browser
UNISWAP_V2_ROUTER=
WATCH_PAIR_ADDRESS=
PORT=3001
